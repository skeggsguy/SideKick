# Copy to .env and fill in. .env is gitignored.

# Optional — ONLY for the Sonnet chat option in the web UI. The harness runs
# fully local without it (main model + compaction on your llama.cpp server,
# utilities on the Apple Foundation Model); with it, the chat picker gains a
# single "Sonnet" entry (pinned to medium effort) for the occasional turn that
# wants a cloud frontier model. Nothing else ever uses this key.
# ANTHROPIC_API_KEY=

# REQUIRED: the main model — a local llama.cpp server speaking the fork's
# Anthropic-compatible /v1/messages. Chat and scheduled jobs go here
# (compaction too: thinking on low, 10k think + 10k text), while the small
# utility jobs (gmail triage, approval prediction, chat titles, memory
# extraction) run on the on-device
# Apple Foundation Model, off the llama.cpp server so the chat's cached
# prefix stays warm. See docs/macos-host.md for the Mac mini setup.
HARNESS_LOCAL_URL=http://127.0.0.1:8080
# HARNESS_LOCAL_MODEL=qwen3.8-flash-next

# Optional: tool groups — send the MCP (Google Workspace, Outlook) tool
# definitions on demand via load_tools/call_tool instead of in every prompt.
# Default: on (the local lane's prefix cache is where deferral pays); Sonnet
# chat turns skip it regardless. on | off.
# HARNESS_TOOL_GROUPS=on

# Optional: default thinking effort — off | low | medium | xhigh (default:
# medium; the old high/max fold into xhigh with a startup note, anything else
# is an error). Maps to the chat template's reasoning_effort, and changing it
# mid-chat makes the next reply reread the whole conversation once. Applies
# to runs that don't pick their own (scheduled jobs, watcher runs, the CLI);
# the web chat's picker overrides it per turn (the Sonnet entry pins medium).
# HARNESS_EFFORT=medium

# Optional: hard cap on output tokens (thinking + text) per model call
# (default: 16000). If a response hits this, the UI shows a "truncated" chip.
# On the local lane thinking is capped at this minus 4096 (answer headroom).
# HARNESS_MAX_TOKENS=16000

# Optional: per-turn cap on executed outbound tool calls (web_fetch, web_search,
# browser_fetch, ...) before each further one needs approval (default: 15).
# 0 gates every outbound call — a kill switch, not a normal setting.
# HARNESS_EGRESS_BUDGET=15

# Optional: where the SQLite state lives (default: ~/.local/share/harness/harness.db).
# Keep it on local APFS — never iCloud Drive or a network path (WAL needs local locking).
# HARNESS_DB_PATH=

# Optional: Docker image for the code sandbox. Leave unset normally: the default
# is harness-sandbox:latest (built once by scripts/build_sandbox_image.sh), with a
# fallback to bare python:3.12-slim if that image was never built. Set only to
# pin a different image (used verbatim, trusted as-is).
# HARNESS_SANDBOX_IMAGE=harness-sandbox:latest
# Optional: the sandbox workspace dir (default: <repo>/scratch/sandbox). It's
# mounted at the same absolute path inside the container and on the host, and is
# the ONLY dir exposed to model code — keep it away from secrets/source.
# HARNESS_SANDBOX_MOUNT=

# Optional: the agent's writable file area — os.pathsep-separated roots where
# edit_file and Drive/Gmail downloads may write (default: <repo>/scratch, plus
# HARNESS_SANDBOX_MOUNT when set). Reads stay global apart from a secrets
# denylist. Also injected into MCP server processes at spawn.
# HARNESS_FILE_ROOTS=

# Optional: Chrome CDP debugging port (default: 19222). Must match the
# --remote-debugging-port Chrome is launched with (docs/browser-fallback-setup.md,
# launchd port spec). Uses a non-default
# port to avoid collisions with other Chrome debugging sessions on the machine.
# HARNESS_CDP_PORT=19222

# Optional: where Ollama is reachable for MEMORY EMBEDDINGS only (triage,
# titles, prediction and extraction are on the Apple Foundation Model; the
# classifier/tier Ollama used to serve is dormant). Without it, memory recall
# is keyword-only. The embedder does NOT send OLLAMA_KEEP_ALIVE (only the dormant
# OllamaProvider tier reads it); Ollama's own default unload is already 5m.
# OLLAMA_HOST=http://localhost:11434

# Optional: set to off to disable the on-device Apple Foundation Model
# (gmail triage, approval prediction, chat titles, memory extraction).
# Requires Apple Intelligence enabled (System Settings); 8192-token window —
# anything larger (compaction) rides the local llama.cpp server. When off or
# unavailable these degrade: triage raises as actionable, titles stay NULL,
# extraction traces an error.
# HARNESS_APPLE_FM=on

# Optional: set to off to disable the Gmail inbox watcher in agentd.
# HARNESS_GMAIL_WATCHER=on

# Optional: set to off to disable P(approve) forecasting on parked approvals
# (on-device Apple Foundation Model; feeds the weekly calibration_report).
# HARNESS_APPROVAL_PREDICTION=on

# Optional: set to off to disable the web UI mic button's speech-to-text
# (in-process faster-whisper). See docs/stt-setup.md.
# HARNESS_STT=on

# Optional: Whisper model for dictation (downloads to ~/.cache/huggingface on
# first use, ~1.5 GB for distil-large-v3; lazy-loaded, kept warm after —
# ~1.2-1.8 GB VRAM on GPU, ~1.5-2 GB RAM + slower on CPU). `small.en` is the
# lighter alternative (~190 MB), `large-v3-turbo` the multilingual one.
# HARNESS_STT_MODEL=distil-large-v3

# Optional: where whisper runs. auto = try CUDA, fall back to CPU and stay
# there for the process (always CPU on the Mac); cuda/cpu pin it.
# HARNESS_STT_DEVICE=auto

# Optional: pin the user's local timezone (IANA name, e.g. Europe/Lisbon).
# Normally unset — the iPad/web client reports its own zone on each load and
# scheduled runs (morning briefing) use that. Set this only to override or as a
# fallback when no client has connected. See docs.
# HARNESS_TZ=

# Optional: the daemon's externally-reachable base URL (your tailnet address
# from `tailscale serve status`). Required for the in-app "Connect" OAuth flow
# — it's where Google redirects back. See docs/google-oauth-setup.md.
# HARNESS_PUBLIC_URL=https://your-host.your-tailnet.ts.net

# Optional: the VAPID `sub` claim sent with every Web Push — a contact address
# the push service can use if this application misbehaves. Nobody checks the
# mailbox exists, so the default placeholder (mailto:agent@example.com) works;
# set a real mailto: if you'd rather be reachable. NOT a localhost address —
# Apple rejects those with 403 BadJwtToken (iOS pushes silently stop; Android
# keeps working). Takes effect on the next agentd restart.
# HARNESS_VAPID_SUB=mailto:you@your-domain.example

# Optional: the signature the agent appends to the body of every email it
# drafts or sends. Defaults to a generic "Sent by Sidekick, an AI assistant, on
# behalf of the account owner." Set it to personalise the wording. This text
# goes out on real mail, so keep it accurate. Leading/trailing blank lines are
# added for you.
# HARNESS_AGENT_SIGNATURE=

# Optional (P6): Microsoft 365 MCP server (read-only personal-account safety net).
# Application (client) ID of your Azure app registration — see
# docs/ms365-setup.md, then enable the server in src/harness/mcp/servers.toml.
# MS365_CLIENT_ID=

# Recommended: bearer token for non-browser clients of the daemon's
# state-changing API routes (the CLI's `trigger fire`, curl, scripts).
# Browser requests authenticate by same-origin instead. Without it,
# Origin-less POSTs are rejected (fail closed). Generate with e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# HARNESS_API_TOKEN=

# Optional: Brave Search API key enables the web_search tool
# (https://brave.com/search/api/ — free tier is plenty for one user).
# Without it the tool is simply absent; web_fetch works regardless.
# BRAVE_SEARCH_API_KEY=

# Optional: Google Maps Platform key enables maps_search + maps_route
# (Places API (New) + Routes API — see docs/maps-setup.md). Without it the
# tools are simply absent.
# GOOGLE_MAPS_API_KEY=
