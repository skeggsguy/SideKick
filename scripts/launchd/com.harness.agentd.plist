<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.harness.agentd</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/YOU/dev/sidekick/scripts/launchd/agentd-wrapper.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/YOU/dev/sidekick</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>ExitTimeOut</key>
    <integer>30</integer>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>/Users/YOU/Library/Logs/harness/agentd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/YOU/Library/Logs/harness/agentd.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <!-- launchd starts agents with a BARE PATH and expands no ~: every entry
             (venv bin, ~/.local/bin for uv, /opt/homebrew/bin for docker) is absolute. -->
        <key>PATH</key>
        <string>/Users/YOU/dev/sidekick/.venv/bin:/Users/YOU/.local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>
</dict>
</plist>
